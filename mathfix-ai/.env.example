# Copy to .env and fill in. Never commit .env.
TELEGRAM_BOT_TOKEN=
MODE=polling                       # polling = local testing; webhook = server
WEBHOOK_BASE_URL=https://bot.mathfix.ai
TELEGRAM_WEBHOOK_SECRET=           # random 32+ chars: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
PORT=8080

GROQ_API_KEY=
CF_ACCOUNT_ID=
CF_AI_API_TOKEN=                   # Cloudflare API token with Workers AI permission
OPENROUTER_API_KEY=                # optional (overflow only)

ADMIN_USER_IDS=                    # your Telegram user id(s), comma-separated
ADMIN_CHAT_ID=                     # private group/channel for alerts (optional)
DATABASE_PATH=data/mathfix.db
LOG_LEVEL=INFO
