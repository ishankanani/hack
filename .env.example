# Copy to .env and fill in. Never commit .env.
# Keep comments on their own lines: systemd's EnvironmentFile does not strip comments after a value.

TELEGRAM_BOT_TOKEN=
# polling = run on your laptop for testing; webhook = server
MODE=polling
WEBHOOK_BASE_URL=https://bot.mathfix.ai
# random 32+ chars: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=
PORT=8080

GROQ_API_KEY=
CF_ACCOUNT_ID=
# Cloudflare API token with Workers AI permission
CF_AI_API_TOKEN=
# optional (overflow only)
OPENROUTER_API_KEY=

# your Telegram user id(s), comma-separated (get it from @userinfobot)
ADMIN_USER_IDS=
# optional: private group/channel id for alerts
ADMIN_CHAT_ID=
DATABASE_PATH=data/mathfix.db
LOG_LEVEL=INFO
# helper processes for maths checks and images (use 1 on a low-memory Windows PC)
SANDBOX_WORKERS=2
